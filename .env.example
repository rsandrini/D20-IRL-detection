RESULT_FOLDER='results'
MODEL_FOLDER='tflite1/custom_model_lite'
# Crop region for the camera feed: x,y,width,height in pixels
# Run scripts/select_roi.py to pick this interactively
# Leave empty to use full frame
CAMERA_ROI=''
# Fixed box size in pixels for the labeling UI (set to match your die's apparent size)
LABEL_BOX_SIZE=100
# Max retries for advantage/disadvantage mode when <2 dice are detected
MAX_RETRIES=3
# Flask session secret key (change in production)
SECRET_KEY='change-me-in-production'
# Admin password for the /admin UI (leave empty to disable login requirement)
ADMIN_PASSWORD=''